{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "topFilesLength": 10,
    "showLineNumbers": false,
    "truncateBase64": true
  },
  "include": [],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/package-lock.json",
      "**/*.pdf",
      "*.html",
      "New Text Document.txt",
      "sto-frontend/public/panduan-alur-kerja-sto.html",
      "sto-frontend/dist/**",
      "repomix-output.*"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
